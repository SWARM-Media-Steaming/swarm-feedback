NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
SERVE_WEB=false

JWT_SECRET=local-dev-jwt-secret-change-before-prod
JWT_TTL_SECONDS=43200
DATA_ENCRYPTION_KEY_HEX=0123456789abcdeffedcba98765432100123456789abcdeffedcba9876543210
BOOTSTRAP_TOKEN=local-bootstrap-token

DYNAMODB_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=swarmfb_
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

SEED_DEMO=true
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=local-admin-pass-1
ADMIN_NAME=Local Admin
REVIEWER_EMAIL=reviewer@localhost
REVIEWER_PASSWORD=local-reviewer-pass-1
REVIEWER_NAME=Local Reviewer
